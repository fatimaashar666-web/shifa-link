# ShifaLink — Environment Variables

# Copy this file to .env.local for local development.
# NEVER commit .env.local or any file containing real secrets to Git.
# All keys listed here are REQUIRED unless marked optional.

# ─────────────────────────────────────────────
# DATABASE
# ─────────────────────────────────────────────
# PostgreSQL connection string
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/shifalink?schema=public&pgbouncer=true"

# ─────────────────────────────────────────────
# AUTHENTICATION (Auth.js)
# ─────────────────────────────────────────────
# Generate with: openssl rand -base64 32
AUTH_SECRET="REPLACE_WITH_RANDOM_SECRET"

# Cookie signing secret for the custom session flow (minimum 32 characters)
SESSION_SECRET="REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARACTERS"

# Base URL of this application (no trailing slash)
NEXTAUTH_URL="http://localhost:3000"

# ─────────────────────────────────────────────
# SANITY CMS
# ─────────────────────────────────────────────
# Public (safe to expose to browser for Studio)
NEXT_PUBLIC_SANITY_PROJECT_ID="REPLACE_WITH_PROJECT_ID"
NEXT_PUBLIC_SANITY_DATASET="production"

# Server-only write token — NEVER expose to browser
SANITY_API_WRITE_TOKEN="REPLACE_WITH_WRITE_TOKEN"

# Webhook secret for cache revalidation signature validation
SANITY_WEBHOOK_SECRET="REPLACE_WITH_WEBHOOK_SECRET"

# ─────────────────────────────────────────────
# OBJECT STORAGE (S3-compatible)
# ─────────────────────────────────────────────
STORAGE_ENDPOINT="https://REPLACE.example.com"
STORAGE_BUCKET_NAME="shifalink-medical-records"
STORAGE_ACCESS_KEY_ID="REPLACE_WITH_ACCESS_KEY"
STORAGE_SECRET_ACCESS_KEY="REPLACE_WITH_SECRET_KEY"
STORAGE_REGION="auto"
# Railway Buckets use virtual-hosted-style URLs. Set true only for a
# legacy/path-style S3-compatible bucket.
STORAGE_FORCE_PATH_STYLE="false"

# Max allowed upload size in bytes (default 50 MB)
STORAGE_MAX_FILE_SIZE_BYTES="52428800"

# ─────────────────────────────────────────────
# REDIS (BullMQ)
# ─────────────────────────────────────────────
REDIS_URL="redis://localhost:6379"

# ─────────────────────────────────────────────
# EMAIL (Notifications)
# ─────────────────────────────────────────────
EMAIL_FROM="noreply@shifalink.example.com"
EMAIL_SMTP_HOST="REPLACE_WITH_SMTP_HOST"
EMAIL_SMTP_PORT="587"
EMAIL_SMTP_USER="REPLACE_WITH_SMTP_USER"
EMAIL_SMTP_PASSWORD="REPLACE_WITH_SMTP_PASSWORD"

# ─────────────────────────────────────────────
# GOOGLE CLOUD TRANSLATION
# ─────────────────────────────────────────────
# Path to service account JSON (server-only) OR use Workload Identity
GOOGLE_CLOUD_PROJECT_ID="REPLACE_WITH_GCP_PROJECT_ID"
# Option A: JSON key file path (local dev)
GOOGLE_APPLICATION_CREDENTIALS="/path/to/service-account.json"
# Option B: Inline JSON (some hosting platforms — keep server-only)
# GOOGLE_CLOUD_CREDENTIALS_JSON="{ ... }"

# ─────────────────────────────────────────────
# AI PROVIDER (runtime application agents)
# Provider TBD — add keys here when decided
# ─────────────────────────────────────────────
AI_PROVIDER_API_KEY="REPLACE_WITH_AI_API_KEY"
AI_PROVIDER_MODEL="REPLACE_WITH_MODEL_ID"

# ─────────────────────────────────────────────
# APPLICATION
# ─────────────────────────────────────────────
# Node environment
NODE_ENV="development"

# Default locale (must be one of: en, ur, de, ar, fr, ja)
DEFAULT_LOCALE="en"

# ─────────────────────────────────────────────
# OPTIONAL / FEATURE FLAGS
# ─────────────────────────────────────────────
# Enable Sanity preview mode (true/false)
SANITY_PREVIEW_ENABLED="false"

# Enable AI chat support feature (true/false)
FEATURE_AI_CHAT="false"

# Enable pre-triage clinical feature (true/false)
FEATURE_PRE_TRIAGE="false"
